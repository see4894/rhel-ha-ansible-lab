global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    fall 2
    rise 2
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == 'lb1' else 'BACKUP' }}
    interface ens18
    virtual_router_id 51
    priority {{ 110 if inventory_hostname == 'lb1' else 100 }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass lab1234
    }
    virtual_ipaddress {
        10.10.10.80/24
    }
    track_script {
        chk_haproxy
    }
}
