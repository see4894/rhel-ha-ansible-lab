global
    log /dev/log local0
    maxconn 2000
    user haproxy
    group haproxy
    daemon

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend web
    bind *:80
    http-request return status 200 content-type text/plain string "served by {{ inventory_hostname }}" if { path /whoami }
    stats enable
    stats uri /haproxy-stats
    default_backend was

backend was
    balance roundrobin
    option httpchk GET /app/  
    server was1 10.10.10.73:8080 check
    server was2 10.10.10.74:8080 check
